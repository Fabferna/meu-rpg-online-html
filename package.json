{
  "name": "aethelgard-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint:security": "eslint -c eslint.security.config.mjs src",
    "audit:prod": "npm audit --omit=dev",
    "secrets:scan": "detect-secrets scan --exclude-files 'node_modules|\\.next|package-lock\\.json|public/' .",
    "pentest": "node scripts/security/pentest.mjs",
    "test:db:setup": "bash scripts/dbtest/setup.sh",
    "test:db:items": "tsx --conditions=react-server scripts/dbtest/check-items.ts",
    "test:db:ch11": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/repro-ch11.ts",
    "test:db:loot": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/test-loot.ts",
    "test:db:shop": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/test-shop.ts",
    "test:db:flows": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/test-flows.ts",
    "test:db:worldboss": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/test-world-boss.ts",
    "test:db:collector": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/test-collector-sets.ts",
    "sim:act2": "TSX_TSCONFIG_PATH=scripts/dbtest/tsconfig.json tsx --conditions=react-server scripts/dbtest/sim-act2.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "motion": "12.43.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-security": "^3.0.1",
    "pg": "8.23.1",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
