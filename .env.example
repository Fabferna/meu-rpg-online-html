# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ir para o navegador: o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave SECRETA (service_role). NUNCA exponha no frontend nem use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada nos redirects de OAuth / confirmação de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Rate limit distribuído (opcional, recomendado em produção) ────
# Sem isso, usa um limitador em memória (ok para dev / 1 instância).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Pagamentos ───────────────────────────────────────────────────
# Stripe (cartão, BRL e USD): Dashboard → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Mercado Pago (Pix/cartão/boleto, BRL): Suas integrações → Credenciais / Webhooks
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Somente desenvolvimento: botão "Teste (dev)" que aprova pagamentos falsos.
# Ignorado automaticamente quando NODE_ENV=production.
PAYMENTS_DEV=1
